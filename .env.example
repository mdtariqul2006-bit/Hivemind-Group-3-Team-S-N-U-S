# Copy this file to .env.local and fill in a value before running the app.
#
# Secret used to sign and verify the admin console's JWT (src/lib/auth/jwt.ts).
# This is a client-side prototype, the token is signed in the browser, so this
# is not a real production secret store, any value works locally. Never reuse
# a real production secret here.
VITE_JWT_SECRET=change-me-to-any-local-dev-value
